{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "loong-campus-game",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-24",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "game.loong.ydtandll.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/data/league-config.json"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "loong-league",
			"database_id": "1629f5e8-bcae-4e27-b9af-21fb12cbcb2b",
			"migrations_dir": "./migrations"
		}
	],
	"ratelimits": [
		{
			"name": "START_CLIENT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "START_IP_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
